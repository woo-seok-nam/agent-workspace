{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_clarification",
        "draft"
      ]
    },
    "intent": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "maxLength": 4000
        },
        "requirements": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "assumptions": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "deliverable": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "goal",
        "requirements",
        "assumptions",
        "deliverable"
      ],
      "additionalProperties": false
    },
    "questions": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "workflow": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "nodes": {
              "minItems": 4,
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "input",
                      "work_step",
                      "output"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "input_ports": {
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "text",
                            "table",
                            "object",
                            "file_ref"
                          ]
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "fields": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                              },
                              "type": {
                                "type": "string",
                                "enum": [
                                  "text",
                                  "number",
                                  "boolean"
                                ]
                              },
                              "required": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "name",
                              "type",
                              "required"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "name",
                        "type",
                        "description",
                        "required",
                        "fields"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "output_ports": {
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "text",
                            "table",
                            "object",
                            "file_ref"
                          ]
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "fields": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                              },
                              "type": {
                                "type": "string",
                                "enum": [
                                  "text",
                                  "number",
                                  "boolean"
                                ]
                              },
                              "required": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "name",
                              "type",
                              "required"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "name",
                        "type",
                        "description",
                        "required",
                        "fields"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "task": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "work",
                              "final_review"
                            ]
                          },
                          "purpose": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4000
                          },
                          "instructions": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4000
                          },
                          "completion_criteria": {
                            "minItems": 1,
                            "maxItems": 40,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4000
                            }
                          },
                          "rationale": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "reference_applied",
                                  "reference_adapted",
                                  "model_proposal"
                                ]
                              },
                              "reference_id": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 4000
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "location": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 4000
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "reason": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              }
                            },
                            "required": [
                              "kind",
                              "reference_id",
                              "location",
                              "reason"
                            ],
                            "additionalProperties": false
                          },
                          "prerequisites": {
                            "maxItems": 40,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "enum": [
                                    "input",
                                    "human",
                                    "tool"
                                  ]
                                },
                                "description": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 4000
                                },
                                "input_port": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "kind",
                                "description",
                                "input_port"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required_tools": {
                            "maxItems": 20,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            }
                          },
                          "missing_capabilities": {
                            "maxItems": 40,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4000
                            }
                          },
                          "requirement_refs": {
                            "maxItems": 40,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4000
                            }
                          }
                        },
                        "required": [
                          "kind",
                          "purpose",
                          "instructions",
                          "completion_criteria",
                          "rationale",
                          "prerequisites",
                          "required_tools",
                          "missing_capabilities",
                          "requirement_refs"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "type",
                  "name",
                  "input_ports",
                  "output_ports",
                  "task"
                ],
                "additionalProperties": false
              }
            },
            "edges": {
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source_node": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "source_port": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "target_node": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "target_port": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  }
                },
                "required": [
                  "source_node",
                  "source_port",
                  "target_node",
                  "target_port"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "name",
            "nodes",
            "edges"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "intent",
    "questions",
    "workflow"
  ],
  "additionalProperties": false
}
