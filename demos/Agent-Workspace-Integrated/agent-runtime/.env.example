# 학교 FactChat Gateway: 키 하나를 세 모델이 공유합니다.
AI_BACKEND=factchat
FACTCHAT_API_KEY=
FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# npm.cmd run models로 조회한 정확한 모델 ID를 입력하세요.
# 실제 사용할 모델만 채워도 됩니다.
OPENAI_MODEL=
GEMINI_MODEL=
CLAUDE_MODEL=

# Workflow 설계에 쓸 공급자: openai / gemini / claude
WORKFLOW_PROVIDER=openai
# 비워두면 위에서 선택한 공급자의 MODEL을 사용합니다.
WORKFLOW_MODEL=

# 기존 본사 API를 직접 사용할 때만 AI_BACKEND=direct로 바꾸고 설정합니다.
# 학교 키를 여기에 넣지 마세요. direct 모드의 Claude는 아직 미지원입니다.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
