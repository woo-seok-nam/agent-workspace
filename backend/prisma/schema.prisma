generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id             String   @id
  name           String
  description    String?
  modelId        String
  toolIds        String
  enabled        Boolean  @default(true)

  systemPrompt   String?
  temperature    Float    @default(0.2)
  maxTokens      Int      @default(4096)
  retryCount     Int      @default(2)
  timeoutSeconds Int      @default(60)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Tool {
  id          String   @id
  name        String
  description String?
  type        String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Provider {
  id               String   @id
  name             String
  description      String
  enabled          Boolean  @default(true)
  connectionStatus String   @default("not_configured")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Workflow {
  id          String         @id
  name        String
  description String?
  nodes       WorkflowNode[]
  edges       WorkflowEdge[]
  runs        WorkflowRun[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model WorkflowNode {
  id          String @id @default(cuid())
  nodeId      String
  workflowId  String
  type        String
  name        String
  description String?
  positionX   Float
  positionY   Float
  agentId     String?
  modelId     String?
  toolIds     String
  config      String

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, nodeId])
  @@index([workflowId])
}

model WorkflowEdge {
  id           String @id @default(cuid())
  edgeId       String
  workflowId   String
  source       String
  target       String
  sourceHandle String?
  targetHandle String?
  condition    String?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, edgeId])
  @@index([workflowId])
}

model WorkflowRun {
  id          String   @id
  workflowId  String
  name        String
  prompt      String?
  status      String   @default("QUEUED")
  tokenUsage  Int      @default(0)
  cost        Float    @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow  Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns  StepRun[]
  artifacts Artifact[]

  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
}

model StepRun {
  id             String   @id
  runId          String
  nodeId         String
  status         String   @default("PENDING")
  approvalStatus String?
  input          String?
  output         String?
  logs           String   @default("[]")
  tokenUsage     Int      @default(0)
  cost           Float    @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId])
  @@index([runId])
  @@index([status])
}

model Artifact {
  id        String   @id
  runId     String
  name      String
  type      String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}