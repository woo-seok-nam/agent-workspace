generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id          String   @id
  name        String
  description String?
  modelId     String
  toolIds     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tool {
  id          String   @id
  name        String
  description String?
  type        String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Provider {
  id               String   @id
  name             String
  description      String
  enabled          Boolean  @default(true)
  connectionStatus String   @default("not_configured")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}