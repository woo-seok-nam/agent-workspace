{
  "name": "agent-workspace-backend",
  "version": "1.0.0",
  "description": "Backend API and orchestration server for Agent Workspace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma skills sync || exit 0"
  },
